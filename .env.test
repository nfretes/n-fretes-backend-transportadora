# Variáveis de Ambiente - Ambiente de Teste (Contabo)
# Copie este arquivo para .env.test no servidor

# Configurações do Banco de Dados de Teste
DATABASE_HOST=postgres-test
DATABASE_PORT=5432
DATABASE_NAME=nfretes_test_db
DATABASE_USERNAME=nfretes_test
DATABASE_PASSWORD=test123456

# JWT - Teste (pode usar chaves simples)
JWT_SECRET=test_jwt_key_for_development_environment
JWT_EXPIRATION=24h

# Google Maps API (use a mesma chave da AWS ou uma de teste)
GOOGLE_MAPS_API_KEY=sua_chave_google_maps_aqui

# PostgreSQL Password (mesmo valor do DATABASE_PASSWORD)
POSTGRES_TEST_PASSWORD=test123456

# Outras configurações que podem ser necessárias para teste
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1