  "como_usar_no_frontend": {
    "descricao": "No frontend, você busca as features e verifica isVisible",
    "exemplo_react": {
      "codigo": "const features = await api.get('/ui-features/visible');\nconst canExport = features.find(f => f.key === 'freight.export.button')?.isVisible;\n\nif (canExport) {\n  return <ExportButton />;\n}"
    },
    "exemplo_angular": {
      "codigo": "*ngIf=\"isFeatureVisible('freight.export.button')\"\n\nisFeatureVisible(key: string): boolean {\n  return this.features.find(f => f.key === key)?.isVisible || false;\n}"
    }
  },
  "casos_de_uso": {
    "planos": {
      "FREE": {
        "descricao": "Usuários free só veem features com isVisible: true e metadata.premium: false/undefined",
        "exemplo_query": "WHERE isVisible = true AND (metadata->>'premium' IS NULL OR metadata->>'premium' = 'false')"
      },
      "PRO": {
        "descricao": "Usuários PRO veem tudo que está isVisible: true",
        "exemplo_query": "WHERE isVisible = true"
      }
    },
    "feature_flags": {
      "descricao": "Use isVisible para controlar rollout de features",
      "exemplo": "Crie a feature com isVisible: false, teste internamente, depois mude para true"
    },
    "customizacao_por_cliente": {
      "descricao": "Você pode ter uma tabela intermediária (ui-feature-permissions) para override por empresa",
      "exemplo": "Empresa X quer ocultar o botão de exportação mesmo tendo plano PRO"
    }
  }
